# Pummel Party's own decompiled source. Kept locally to develop against; it is the studio's
# code, not ours, and must never be published.
decompiled/

# Third-party binaries - ILSpy's decompiler and the Roslyn compiler. Fetched, not authored;
# see the README for where they come from.
tools/

# Unity working directories: regenerated on every open, enormous, and machine-specific.
unity/PPAssets/Library/
unity/PPAssets/Temp/
unity/PPAssets/Obj/
unity/PPAssets/Logs/
unity/PPAssets/UserSettings/
unity/PPAssets/[Bb]uild/
unity/PPAssets/*.csproj
unity/PPAssets/*.sln

# Built output. The bundle is an artefact of Assets/ plus the build script, so it is rebuilt
# rather than tracked; releases carry a copy for people who do not want to install Unity.
unity/PPAssets/BuiltBundles/
unity/build.log
unity/iconpreview.log
unity/iconzoom.log
mod/bin/
mod/obj/

# Icon review sheets: rendered on demand from the models, no reason to keep versions of them.
unity/PPAssets/IconSheet.png
unity/PPAssets/IconZoom.png
unity/PPAssets/zoom.txt

# Editor and OS noise
.vs/
.idea/
*.user
Thumbs.db
desktop.ini
.DS_Store

# Generated by BundleBuilder on every build from the scripts in Assets/Editor. Committing
# them would mean a few hundred binary files churning on each rebuild for no gain - the
# scripts are the source, these are the output.
unity/PPAssets/Assets/Materials/
unity/PPAssets/Assets/Meshes/
unity/PPAssets/Assets/Prefabs/
